/// Public holidays of Lisbon (src_Holidays typed); not loaded.
expression Holidays =
		let
		    Typed = Table.TransformColumns(src_Holidays, {{"date", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type date}}),
		    Renamed = Table.RenameColumns(Typed, {{"date", "Date"}, {"name", "Holiday"}, {"scope", "Scope"}})
		in
		    Renamed
