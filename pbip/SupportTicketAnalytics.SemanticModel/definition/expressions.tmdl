/// The holiday dates as a buffered list for fnBusinessMinutes.
expression HolidayList =
		List.Buffer(Holidays[Date])
	lineageTag: ac613075-55f5-59a3-bfcb-8ea7b9f6c289

	annotation PBI_ResultType = List

/// Business minutes between two datetimes: Monday to Friday 08:00 to 18:00, holidays excluded (docs/business-hours.md).
expression fnBusinessMinutes =
		(start as nullable datetime, finish as nullable datetime) as nullable number =>
		    if start = null or finish = null or finish < start then null
		    else List.Sum(List.Transform(
		        List.Dates(DateTime.Date(start), Duration.Days(DateTime.Date(finish) - DateTime.Date(start)) + 1, #duration(1, 0, 0, 0)),
		        (d as date) as number =>
		            if Date.DayOfWeek(d, Day.Monday) >= 5 or List.Contains(HolidayList, d) then 0
		            else let s = List.Max({start, d & #time(8, 0, 0)}), e = List.Min({finish, d & #time(18, 0, 0)})
		                 in if e > s then Duration.TotalMinutes(e - s) else 0))
	lineageTag: a04f6706-a3ff-5e61-9ea7-5f3d8f64cc59

	annotation PBI_ResultType = Function

/// The quarterly ticket files of src_Tickets combined and typed; not loaded.
expression TicketFiles =
		let
		    Stamp = (x as nullable text) as nullable datetime =>
		        if x = null or x = "" then null else DateTime.FromText(x, [Format = "yyyy-MM-dd HH:mm", Culture = "en-US"]),
		    Whole = (x as nullable text) as nullable number => if x = null or x = "" then null else Number.FromText(x, "en-US"),
		    Combined = Table.Combine(src_Tickets[Rows]),
		    Typed = Table.TransformColumns(Combined, {{"ticket_id", Whole, Int64.Type}, {"created_at", Stamp, type datetime},
		        {"team_id", Whole, Int64.Type}, {"agent_id", Whole, Int64.Type}, {"first_response_at", Stamp, type nullable datetime},
		        {"resolved_at", Stamp, type nullable datetime}, {"closed_at", Stamp, type nullable datetime},
		        {"reopen_count", Whole, Int64.Type}, {"csat_score", Whole, Int64.Type}})
		in
		    Typed
	lineageTag: f4dbd66b-9e5c-5b9b-88ea-a6dd6fa70c31

	annotation PBI_ResultType = Table

/// The quarterly event files of src_Events combined and typed; not loaded.
expression EventFiles =
		let
		    Stamp = (x as nullable text) as nullable datetime =>
		        if x = null or x = "" then null else DateTime.FromText(x, [Format = "yyyy-MM-dd HH:mm", Culture = "en-US"]),
		    Whole = (x as nullable text) as nullable number => if x = null or x = "" then null else Number.FromText(x, "en-US"),
		    Combined = Table.Combine(src_Events[Rows]),
		    Typed = Table.TransformColumns(Combined, {{"event_id", Whole, Int64.Type}, {"ticket_id", Whole, Int64.Type},
		        {"event_seq", Whole, Int64.Type}, {"event_at", Stamp, type datetime},
		        {"from_status", each if _ = "" then null else _, type nullable text}, {"agent_id", Whole, Int64.Type}})
		in
		    Typed
	lineageTag: c4fd1f47-604c-5b64-b1b6-7072730ab105

	annotation PBI_ResultType = Table

/// One row per event with the interval to the next event (or AsOf) in business minutes; not loaded.
expression EventIntervals =
		let
		    OpenStates = {"New", "Open", "Pending", "Reopened"},
		    ClockStates = {"New", "Open", "Reopened"},
		    Events = Table.Buffer(Table.Sort(EventFiles, {{"ticket_id", Order.Ascending}, {"event_seq", Order.Ascending}})),
		    Following = Table.SelectColumns(Events, {"ticket_id", "event_seq", "event_at"}),
		    Keyed = Table.AddColumn(Events, "next_seq", each [event_seq] + 1, Int64.Type),
		    Merged = Table.NestedJoin(Keyed, {"ticket_id", "next_seq"}, Following, {"ticket_id", "event_seq"}, "Next", JoinKind.LeftOuter),
		    WithNext = Table.ExpandTableColumn(Merged, "Next", {"event_at"}, {"next_event_at"}),
		    WithEnd = Table.AddColumn(WithNext, "interval_end", each if [next_event_at] <> null then [next_event_at]
		        else if [to_status] = "Closed" then null else AsOf, type nullable datetime),
		    WithBmin = Table.AddColumn(WithEnd, "interval_bmin", each fnBusinessMinutes([event_at], [interval_end]), Int64.Type),
		    Running = Table.AddColumn(WithBmin, "clock_running", each List.Contains(ClockStates, [to_status]), type logical),
		    Delta = Table.AddColumn(Running, "backlog_delta", each (if List.Contains(OpenStates, [to_status]) then 1 else 0)
		        - (if List.Contains(OpenStates, [from_status]) then 1 else 0), Int64.Type),
		    EventDate = Table.AddColumn(Delta, "event_date", each DateTime.Date([event_at]), type date),
		    Created = Table.SelectColumns(TicketFiles, {"ticket_id", "created_at"}),
		    WithCreated = Table.ExpandTableColumn(Table.NestedJoin(EventDate, {"ticket_id"}, Created, {"ticket_id"}, "Ticket",
		        JoinKind.LeftOuter), "Ticket", {"created_at"}, {"ticket_created_at"}),
		    CreatedDate = Table.AddColumn(WithCreated, "ticket_created_date", each DateTime.Date([ticket_created_at]), type date),
		    Agents = Table.TransformColumns(src_Agents, {{"agent_id", each Number.FromText(_, "en-US"), Int64.Type}}),
		    WithAgent = Table.ExpandTableColumn(Table.NestedJoin(CreatedDate, {"agent_id"}, Agents, {"agent_id"}, "Agent",
		        JoinKind.LeftOuter), "Agent", {"agent_name"}),
		    ActorName = Table.AddColumn(WithAgent, "actor_name", each if [actor] = "Agent" then [agent_name] else [actor], type text),
		    Sorted = Table.Sort(ActorName, {{"ticket_id", Order.Ascending}, {"event_seq", Order.Ascending}})
		in
		    Sorted
	lineageTag: fb2d0cde-6a47-5fd4-944d-9f35c8087a9e

	annotation PBI_ResultType = Table
