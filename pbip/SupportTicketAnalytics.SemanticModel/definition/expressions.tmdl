/// Staging, not loaded: data/holidays.csv as text with the header promoted.
expression src_Holidays =
		let
		    Source = Csv.Document(File.Contents(DataFolder & "\holidays.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true])
		in
		    Promoted
	lineageTag: 4c173891-9be9-57f4-a575-41776c91c0c9

	annotation PBI_ResultType = Table

/// Staging, not loaded: the quarterly ticket files of data/tickets, .csv only in name order; one row per file, its rows as text with the header promoted.
expression src_Tickets =
		let
		    Source = Folder.Files(DataFolder & "\tickets"),
		    CsvFiles = Table.Sort(Table.SelectRows(Source, each [Extension] = ".csv"), {{"Name", Order.Ascending}}),
		    Parsed = Table.AddColumn(CsvFiles, "Rows", each Table.PromoteHeaders(Csv.Document([Content], [Delimiter = ",", Columns = 17,
		        Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])),
		    Result = Table.SelectColumns(Parsed, {"Name", "Rows"})
		in
		    Result
	lineageTag: d4acec3a-6f96-55df-9364-85c82d8e4f3e

	annotation PBI_ResultType = Table

