		sourceColumn: Is open at as-of

		annotation SummarizationSetBy = User

	partition FactTickets = m
		mode: import
		source =
				let
				    OpenStates = {"New", "Open", "Pending", "Reopened"},
				    StatusOrder = {"New", "Open", "Pending", "Resolved", "Closed", "Reopened"},
				    PerTicket = Table.Group(EventIntervals, {"ticket_id"}, {
				        {"events", each Table.RowCount(_), Int64.Type},
				        {"new_bmin", each Table.SelectRows(_, each [event_seq] = 1){0}[interval_bmin], Int64.Type},
				        {"clock_bmin", each List.Sum({0} & Table.SelectRows(_, each [clock_running])[interval_bmin]), Int64.Type},
				        {"pending_bmin", each List.Sum({0} & Table.SelectRows(_, each [to_status] = "Pending")[interval_bmin]), Int64.Type},
				        {"ever_resolved", each List.Contains([to_status], "Resolved"), type logical}}),
				    Priorities = Table.TransformColumns(src_Priorities,
				        {{"fr_target_bmin", each Number.FromText(_, "en-US"), Int64.Type}, {"res_target_bmin", each Number.FromText(_, "en-US"), Int64.Type}}),
				    Joined = Table.ExpandTableColumn(Table.NestedJoin(TicketFiles, {"ticket_id"}, PerTicket, {"ticket_id"}, "Intervals",
				        JoinKind.LeftOuter), "Intervals", {"events", "new_bmin", "clock_bmin", "pending_bmin", "ever_resolved"}),
				    WithTargets = Table.ExpandTableColumn(Table.NestedJoin(Joined, {"priority"}, Priorities, {"priority"}, "Targets",
				        JoinKind.LeftOuter), "Targets", {"fr_target_bmin", "res_target_bmin"}),
				    FirstResponse = Table.AddColumn(WithTargets, "first_response_bmin", each if [events] > 1 then [new_bmin] else null, Int64.Type),
				    IsResolved = Table.AddColumn(FirstResponse, "is_resolved", each List.Contains({"Resolved", "Closed"}, [status]), type logical),
				    Resolution = Table.AddColumn(IsResolved, "resolution_bmin", each if [is_resolved] then [clock_bmin] else null, Int64.Type),
				    FrStatus = Table.AddColumn(Resolution, "fr_sla_status", each
				        if [first_response_bmin] <> null then (if [first_response_bmin] <= [fr_target_bmin] then "Met" else "Breached")
				        else if [new_bmin] <> null and [new_bmin] > [fr_target_bmin] then "Breached" else "Pending", type text),
				    ResStatus = Table.AddColumn(FrStatus, "res_sla_status", each
				        if [is_resolved] then (if [resolution_bmin] <= [res_target_bmin] then "Met" else "Breached")
				        else if [clock_bmin] > [res_target_bmin] then "Breached" else "Pending", type text),
				    AnyBreach = Table.AddColumn(ResStatus, "any_sla_breach", each [fr_sla_status] = "Breached" or [res_sla_status] = "Breached",
				        type logical),
				    IsOpen = Table.AddColumn(AnyBreach, "is_open", each List.Contains(OpenStates, [status]), type logical),
				    Number = Table.AddColumn(IsOpen, "ticket_number", each "QS-" & Text.From([ticket_id], "en-US"), type text),
				    CreatedDate = Table.AddColumn(Number, "created_date", each DateTime.Date([created_at]), type date),
				    CreatedHour = Table.AddColumn(CreatedDate, "created_hour", each Time.Hour([created_at]), Int64.Type),
				    ResolvedDate = Table.AddColumn(CreatedHour, "resolved_date", each if [resolved_at] = null then null else DateTime.Date([resolved_at]),
				        type nullable date),
				    Unassigned = Table.TransformColumns(ResolvedDate, {{"agent_id", each if _ = null then 0 else _, Int64.Type}}),
				    StatusSort = Table.AddColumn(Unassigned, "status_sort", each List.PositionOf(StatusOrder, [status]) + 1, Int64.Type),
				    Selected = Table.SelectColumns(StatusSort, {"ticket_id", "ticket_number", "created_at", "created_date", "created_hour", "channel",
				        "category", "priority", "customer_id", "team_id", "agent_id", "subject", "status", "status_sort", "first_response_at",
				        "resolved_at", "resolved_date", "closed_at", "reopen_count", "csat_score", "first_response_bmin", "clock_bmin",
				        "pending_bmin", "resolution_bmin", "fr_sla_status", "res_sla_status", "any_sla_breach", "ever_resolved", "is_resolved",
				        "is_open"}),
				    Renamed = Table.RenameColumns(Selected, {{"ticket_id", "Ticket ID"}, {"ticket_number", "Ticket number"},
				        {"created_at", "Created at"}, {"created_date", "Created date"}, {"created_hour", "Created hour"}, {"channel", "Channel"},
				        {"category", "Category"}, {"priority", "Priority"}, {"customer_id", "Customer ID"}, {"team_id", "Team ID"},
				        {"agent_id", "Agent ID"}, {"subject", "Subject"}, {"status", "Current status"}, {"status_sort", "Current status sort"},
				        {"first_response_at", "First response at"}, {"resolved_at", "Resolved at"}, {"resolved_date", "Resolved date"},
				        {"closed_at", "Closed at"}, {"reopen_count", "Reopen count"}, {"csat_score", "CSAT score"},
				        {"first_response_bmin", "First response bmin"}, {"clock_bmin", "Clock bmin"}, {"pending_bmin", "Pending bmin"},
				        {"resolution_bmin", "Resolution bmin"}, {"fr_sla_status", "FR SLA status"}, {"res_sla_status", "Res SLA status"},
				        {"any_sla_breach", "Any SLA breach"}, {"ever_resolved", "Ever resolved"}, {"is_resolved", "Is resolved"},
				        {"is_open", "Is open at as-of"}})
				in
				    Renamed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

