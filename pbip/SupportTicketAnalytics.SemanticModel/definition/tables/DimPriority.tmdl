/// Priorities P1 to P4 with their SLA targets in business minutes (data/priorities.csv).
table DimPriority
	lineageTag: cd345e05-2437-5511-b4c3-a0d058aa4d26

	column Priority
		dataType: string
		isKey
		lineageTag: 598af737-8cdf-5fd1-b849-cb48ae846b82
		summarizeBy: none
		sourceColumn: Priority
		sortByColumn: 'Priority sort'

		annotation SummarizationSetBy = Automatic

	column 'Priority name'
		dataType: string
		lineageTag: 430ea7ab-0c40-5471-b1d9-83c88f0f547e
		summarizeBy: none
		sourceColumn: Priority name
		sortByColumn: 'Priority sort'

		annotation SummarizationSetBy = Automatic

	column 'Priority sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 59aca690-8e57-5ea4-b1d5-51989388b3c4
		summarizeBy: none
		sourceColumn: Priority sort

		annotation SummarizationSetBy = User

	column 'FR target bmin'
		dataType: int64
		formatString: #,0
		lineageTag: 4df5d8c5-bf10-5bcd-b24e-13bf8a3d279b
