	partition DimPriority = m
		mode: import
		source =
				let
				    Typed = Table.TransformColumnTypes(src_Priorities, {{"priority", type text}, {"priority_name", type text}, {"sort_order", Int64.Type},
				        {"fr_target_bmin", Int64.Type}, {"res_target_bmin", Int64.Type}, {"fr_target_label", type text}, {"res_target_label", type text}},
				        "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"priority", "Priority"}, {"priority_name", "Priority name"}, {"sort_order", "Priority sort"},
				        {"fr_target_bmin", "FR target bmin"}, {"res_target_bmin", "Res target bmin"}, {"fr_target_label", "FR target"},
				        {"res_target_label", "Res target"}})
				in
				    Renamed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

