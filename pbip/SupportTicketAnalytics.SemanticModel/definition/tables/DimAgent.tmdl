/// The 24 agents (data/agents.csv) and row 0 Unassigned for tickets still New; Team name is merged in, so there is no relationship to DimTeam.
table DimAgent
	lineageTag: 9acd510c-7d40-5ff6-9c6c-d534e95bfd63

	column 'Agent ID'
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: b85bb241-95d4-59cd-9c48-e277a2ce2c49
		summarizeBy: none
		sourceColumn: Agent ID

		annotation SummarizationSetBy = User

	column 'Agent name'
		dataType: string
		lineageTag: 6d8ce521-b109-5508-8bb4-165d9808c243
		summarizeBy: none
		sourceColumn: Agent name

		annotation SummarizationSetBy = Automatic

	/// Sign-in address; the RLS role compares it in Security.
	column 'Agent e-mail'
		dataType: string
		isHidden
		lineageTag: fb90d3a0-69b8-591c-beaf-d11178fb6b01
		summarizeBy: none
		sourceColumn: Agent e-mail

		annotation SummarizationSetBy = Automatic

	column 'Team ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 99c097f9-30db-5253-a22e-8a5b3916f6e1
		summarizeBy: none
		sourceColumn: Team ID

		annotation SummarizationSetBy = User

	column 'Team name'
		dataType: string
		lineageTag: ecc40df2-fc26-50d1-8e24-e8428869a726
		summarizeBy: none
		sourceColumn: Team name

		annotation SummarizationSetBy = Automatic

	/// Agent or Team lead (None for Unassigned).
	column Role
		dataType: string
		lineageTag: 08fcfb9d-3d03-5b5d-a8fe-ab1195568b1c
		summarizeBy: none
		sourceColumn: Role

		annotation SummarizationSetBy = Automatic

	column 'Active from'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 7c6f4a21-cd66-53aa-8def-c24302038d03
		summarizeBy: none
		sourceColumn: Active from

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// Blank = still active at the export.
	column 'Active to'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ef49c1e1-f7f7-5842-92b8-629762bf0a74
		summarizeBy: none
		sourceColumn: Active to

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	partition DimAgent = m
		mode: import
		source =
				let
				    Typed = Table.TransformColumns(src_Agents, {{"agent_id", each Number.FromText(_, "en-US"), Int64.Type},
				        {"team_id", each Number.FromText(_, "en-US"), Int64.Type},
				        {"active_from", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type date},
				        {"active_to", each if _ = "" then null else Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				    Teams = Table.TransformColumnTypes(src_Teams, {{"team_id", Int64.Type}, {"team_name", type text}}, "en-US"),
				    WithTeam = Table.ExpandTableColumn(Table.NestedJoin(Typed, {"team_id"}, Teams, {"team_id"}, "Team", JoinKind.LeftOuter),
				        "Team", {"team_name"}),
				    Unassigned = Table.InsertRows(WithTeam, 0, {[agent_id = 0, agent_name = "Unassigned", email = null, team_id = null, role = "None",
				        active_from = null, active_to = null, team_name = null]}),
				    Selected = Table.SelectColumns(Unassigned, {"agent_id", "agent_name", "email", "team_id", "team_name", "role", "active_from",
				        "active_to"}),
				    Renamed = Table.RenameColumns(Selected, {{"agent_id", "Agent ID"}, {"agent_name", "Agent name"}, {"email", "Agent e-mail"},
				        {"team_id", "Team ID"}, {"team_name", "Team name"}, {"role", "Role"}, {"active_from", "Active from"},
				        {"active_to", "Active to"}}),
				    Sorted = Table.Sort(Renamed, {{"Agent ID", Order.Ascending}})
				in
				    Sorted

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
