                  {
                    "textStyle": {
                      "color": "#E6EDF3",
                      "fontSize": "11pt"
                    },
                    "value": "Quillstack Software is a fictional B2B software company in Lisbon, Portugal. Its support desk answers customers in four teams: Service Desk, Technical Support, Billing & Accounts and Integrations."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "textStyle": {
                      "color": "#E6EDF3",
                      "fontSize": "11pt"
                    },
                    "value": "This report shows the help-desk export from January 2024 to September 2025: volume, SLA compliance in business hours, teams and agents, backlog and ageing."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "textStyle": {
                      "color": "#93A1B0",
                      "fontSize": "11pt"
                    },
                    "value": "The company, the customers, the agents and the tickets are invented."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "textStyle": {
                      "color": "#93A1B0",
                      "fontSize": "11pt"
                    },
                    "value": "Rebuilt from memory as a demo. The original client's name and data are not used."
                  }
                ]
              }
            ]
          }
        }
